# ---------------------------------------------------------------------------
# Attachment Runway — environment configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# Node environment. Use "production" on your VPS, "development" locally.
NODE_ENV=production

# Set to "true" ONLY once the app is served over HTTPS. When true the auth
# cookie is marked Secure and browsers will refuse to send it over plain HTTP.
# Leave "false" for local development or a plain-HTTP VPS setup.
COOKIE_SECURE=false

# Neon Postgres connection string. Create a free project at https://neon.tech,
# then copy its connection string here. `sslmode=require` is important.
DATABASE_URL=postgres://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWT auth cookies. Use a long, random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long an auth session lasts (any value the `jsonwebtoken` library accepts).
JWT_EXPIRES_IN=30d

# NVIDIA API (OpenAI-compatible). Get a free key at https://build.nvidia.com.
# Used only server-side to draft cold emails and parse CVs; never exposed to
# the browser. NVIDIA retires models over time (a retired model returns HTTP
# 410) — pick any current chat model your account can call from
# https://build.nvidia.com/models and set it here.
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# Weekly link-check job schedule (cron syntax). Default: 3am every Monday.
CRON_SCHEDULE=0 3 * * 1

# A company whose website hasn't been checked within this many days is flagged
# in the UI as "needs re-verification".
STALE_AFTER_DAYS=30

# ---------------------------------------------------------------------------
# Gmail reply-tracking (optional). When these are set, users can connect their
# Gmail (read-only) on the Profile page and the app will detect company replies
# and auto-update each company's status + notes. Leave blank to disable; the
# feature stays hidden and the sync job idles.
#
# Set up: Google Cloud Console -> APIs & Services -> enable the Gmail API ->
# create an OAuth 2.0 Client ID (type: Web application). Add the redirect URI
# below to the client. On the OAuth consent screen, add the gmail.readonly
# scope and your Google account as a test user (or publish the app).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client, e.g.
# https://attachment.kelvinmomanyi.me/oauth/google/callback
GOOGLE_REDIRECT_URI=

# Key used to encrypt stored Gmail refresh tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the app falls back to JWT_SECRET (a dedicated key is recommended).
TOKEN_ENC_KEY=

# How often to check connected inboxes for replies (cron syntax).
GMAIL_SYNC_SCHEDULE=*/30 * * * *
