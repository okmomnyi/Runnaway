<%- include('partials/head', { title: 'Log in — Attachment Runway' }) %>
<%- include('partials/nav', { active: '' }) %>

<main class="auth-main">
  <section class="auth-card" aria-labelledby="auth-title">
    <img class="auth-logo" src="/public/logo.jpeg" width="72" height="72" alt="Attachment Runway logo: a hooded figure with glowing eyes" />
    <h1 id="auth-title" class="auth-title">Welcome back</h1>
    <p class="auth-sub">Log in to your application tracker.</p>

    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <form action="/login" method="POST" class="form" novalidate>
      <label class="field">
        <span class="field-label">Email</span>
        <input class="input" type="email" name="email" autocomplete="email"
               value="<%= values.email %>" required autofocus />
      </label>
      <label class="field">
        <span class="field-label">Password</span>
        <input class="input" type="password" name="password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="btn btn-primary btn-block">Log in</button>
    </form>

    <p class="auth-alt">New here? <a href="/register">Create an account</a></p>
  </section>
</main>

<%- include('partials/foot') %>
